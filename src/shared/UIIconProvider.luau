--!strict
-- UIIconProvider: uses the supplied repository PNG artwork without requiring a
-- separately uploaded Roblox asset ID. The 64x64 RGBA pixels are decoded into
-- cached EditableImages on the client. A text fallback remains if that API is
-- unavailable in an older Studio build.

local AssetService = game:GetService("AssetService")
local HttpService = game:GetService("HttpService")

local UIIconProvider = {}
local SIZE = Vector2.new(64, 64)
local DATA: { [string]: string } = {
	shop = "",
	pets = "",
	rewards = "",
}
local FALLBACK = { shop = "SHOP", pets = "PETS", rewards = "LUCK" }
local cache: { [string]: any } = {}

local function editableFor(key: string): any?
	if cache[key] then
		return cache[key]
	end
	local encoded = DATA[key]
	if not encoded then
		return nil
	end
	local ok, editable = pcall(function()
		local raw = HttpService:Base64Decode(encoded)
		local image = AssetService:CreateEditableImage({ Size = SIZE })
		image:WritePixelsBuffer(Vector2.zero, SIZE, buffer.fromstring(raw))
		return image
	end)
	if not ok then
		warn("[UIIconProvider] EditableImage unavailable: " .. tostring(editable))
		return nil
	end
	cache[key] = editable
	return editable
end

function UIIconProvider.Apply(button: GuiButton, key: string): GuiObject
	local previous = button:FindFirstChild("ActionIcon")
	if previous then
		previous:Destroy()
	end
	local image = Instance.new("ImageLabel")
	image.Name = "ActionIcon"
	image.AnchorPoint = Vector2.new(0.5, 0)
	image.Position = UDim2.new(0.5, 0, 0, 4)
	image.Size = UDim2.new(1, -12, 1, -24)
	image.BackgroundTransparency = 1
	image.ScaleType = Enum.ScaleType.Fit
	image.ZIndex = button.ZIndex + 1
	image.Parent = button
	local editable = editableFor(key)
	local applied = false
	if editable then
		applied = pcall(function()
			(image :: any).ImageContent = Content.fromObject(editable)
		end)
	end
	if applied then
		return image
	end
	image:Destroy()
	local fallback = Instance.new("TextLabel")
	fallback.Name = "ActionIcon"
	fallback.AnchorPoint = Vector2.new(0.5, 0)
	fallback.Position = UDim2.new(0.5, 0, 0, 8)
	fallback.Size = UDim2.new(1, -10, 1, -28)
	fallback.BackgroundTransparency = 1
	fallback.Font = Enum.Font.FredokaOne
	fallback.Text = FALLBACK[key] or string.upper(key)
	fallback.TextColor3 = Color3.fromRGB(255, 255, 248)
	fallback.TextScaled = true
	fallback.ZIndex = button.ZIndex + 1
	fallback.Parent = button
	return fallback
end

return UIIconProvider
