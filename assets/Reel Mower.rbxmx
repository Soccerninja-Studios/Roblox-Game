script.Parent.Values.SteerC.Changed:connect(function()
	local ex = 2.5
	if script.Parent.Values.SteerC.Value<0 then ex=-2.5 end
	car.Misc.Wheel.A.W.DesiredAngle = script.Parent.Values.SteerC.Value^2*math.rad(200)*ex
end)]]></ProtectedString>
