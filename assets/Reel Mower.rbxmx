						<Properties>
							<ProtectedString name="Source"><![CDATA[local P			= script.Parent
local player 	= game.Players.LocalPlayer
local character = player.Character
local mouse 	= player:GetMouse()
wait(0.2)
local ride 			= P.Car.Value
local camType 		= 5
local unitType = 6
local currentVel = 0
local F1 = ride.Parent.Body.Jets.F1.Fire
local F2 = ride.Parent.Body.Jets.F2.Fire
local T1 = ride.Parent.Body.Jets.T1.BodyThrust
local T2 = ride.Parent.Body.Jets.T2.BodyThrust
local jetspeed = 10000

function jets()
	if F1.Enabled == false then
		F1.Enabled = true
		F2.Enabled = true
		T1.force = Vector3.new (0, jetspeed, 0)
		T2.force = Vector3.new (0, jetspeed, 0)
	elseif F1.Enabled == true then
		F1.Enabled = false
		F2.Enabled = false
		T1.force = Vector3.new (0, 0, 0)
		T2.force = Vector3.new (0, 0, 0)
	end	
end
mouse.KeyDown:connect(function (key)
	if (key == 'f') then jets()

	end
end)

]]></ProtectedString>
