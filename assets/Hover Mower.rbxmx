				<Item class="Script" referent="RBX7D5165D7B84A4B4BACBF3CFC29D14E57">
					<Properties>
						<ProtectedString name="Source"><![CDATA[function Forward()
script.Parent.BodyForce.force = Vector3.new(0 , 0, 0)
script.Parent.Parent.Rotator.LeftParamA = 0.1
script.Parent.Parent.Rotator.LeftParamB = 0.2
wait(0.5)
script.Parent.Parent.Rotator.RightParamA = 0.1
script.Parent.Parent.Rotator.RightParamB = -0.2
end

function Reverse()
script.Parent.BodyForce.force = Vector3.new(0 , 0, 0)
script.Parent.Parent.Rotator.RightParamA = 0.1
script.Parent.Parent.Rotator.RightParamB = 0.2
wait(0.5)
script.Parent.Parent.Rotator.LeftParamA = 0.1
script.Parent.Parent.Rotator.LeftParamB = -0.2
end

function Stop()
script.Parent.BodyForce.force = Vector3.new(0 , -9e+004, 0)
script.Parent.Parent.Rotator.RightParamA = 0
script.Parent.Parent.Rotator.RightParamB = 0
script.Parent.Parent.Rotator.LeftParamA = 0
script.Parent.Parent.Rotator.LeftParamB = 0
end

while true do
	if script.Parent.Throttle == 1 then
	Forward()
	elseif script.Parent.Throttle == -1 then
	Reverse()
	elseif script.Parent.Throttle == 0 then
	Stop()
	end
wait()
end ]]></ProtectedString>
