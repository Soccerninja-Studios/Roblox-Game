			<Item class="Script" referent="RBX0E5577F0B85F4544832303F1FE301CB6">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local mech = script.Parent
local seat = mech.WalkControl
seat.Turn_.cframe = seat.CFrame
while wait(.1) do
seat.Dir_.velocity = seat.CFrame.lookVector * 32 *seat.Throttle
seat.Turn_.cframe = seat.Turn_.cframe * CFrame.Angles(0, -math.pi/10 * seat.Steer * math.abs(seat.Throttle) , 0)
end
]]></ProtectedString>
