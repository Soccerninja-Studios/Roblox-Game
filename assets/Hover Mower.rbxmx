							<R21>0</R21>
							<R22>1</R22>
						</CoordinateFrame>
						<float name="D">10.9082527</float>
						<Vector3 name="MaxTorque">
							<X>4060.71191</X>
							<Y>406071200</Y>
							<Z>4060.71191</Z>
						</Vector3>
						<float name="P">140.653137</float>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
