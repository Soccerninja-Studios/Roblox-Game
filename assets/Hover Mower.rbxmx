					<Properties>
						<ProtectedString name="Source"><![CDATA[function Right()
script.Parent.Parent.Rotator.BodyAngularVelocity.angularvelocity = Vector3.new(0, -2, 0)
end

function Left()
script.Parent.Parent.Rotator.BodyAngularVelocity.angularvelocity = Vector3.new(0, 2, 0)
end

function Stop()
script.Parent.Parent.Rotator.BodyAngularVelocity.angularvelocity = Vector3.new(0, 0, 0)
end

while true do
	if script.Parent.Steer == 1 then
	Right()
	elseif script.Parent.Steer == -1 then
	Left()
	elseif script.Parent.Steer == 0 then
	Stop()
	end
wait()
end ]]></ProtectedString>
